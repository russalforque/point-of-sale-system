# Copy to android/keystore.properties (git-ignored) and fill in your real values.
# Keep the .jks file OUTSIDE this repository and back it up - losing it means
# customers cannot install future updates over their existing Sellix install.
# Use forward slashes in the path, even on Windows.
storeFile=C:/Users/PC/sellix-keys/sellix-release.jks
storePassword=
keyAlias=sellix
keyPassword=
